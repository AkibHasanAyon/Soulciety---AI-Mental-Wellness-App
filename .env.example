# Example environment variables for local docker-compose
# Copy this to .env and fill values before running

DEBUG=0
SECRET_KEY=changeme
DJANGO_SETTINGS_MODULE=tlecap_backend.settings
ALLOWED_HOSTS=localhost,127.0.0.1

# Celery/Redis broker
CELERY_BROKER_URL=redis://redis:6379/0

# Database: this project uses sqlite by default. If you use Postgres, set DATABASE_URL accordingly.
# DATABASE_URL=postgres://user:pass@db:5432/dbname
